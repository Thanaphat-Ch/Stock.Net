@model MyApiProject.Features.Account.RegisterViewModel

<div class="min-h-[80vh] flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-md w-full space-y-8 bg-white p-8 border border-neutral-200 rounded-xl shadow-sm">
        <div class="text-center">
            <h2 class="text-2xl font-bold tracking-tight text-neutral-900">สร้างบัญชีผู้ใช้</h2>
            <p class="mt-2 text-sm text-neutral-600">กรอกข้อมูลเพื่อลงทะเบียนเข้าใช้งานระบบ</p>
        </div>

        <form asp-controller="Account" asp-action="Register" method="post" class="mt-8 space-y-5">
            <div asp-validation-summary="ModelOnly" class="p-3 bg-red-50 border border-red-200 rounded-lg text-sm text-red-600"></div>

            <div>
                <label asp-for="Name" class="block text-sm font-medium text-neutral-700">ชื่อ-นามสกุล</label>
                <div class="mt-1">
                    <input asp-for="Name"
                           class="w-full px-3 py-2 border border-neutral-300 rounded-lg text-neutral-900 placeholder-neutral-400 focus:outline-none focus:ring-2 focus:ring-black focus:border-black sm:text-sm"
                           placeholder="ชื่อ นามสกุล" />
                </div>
                <span asp-validation-for="Name" class="mt-1 block text-xs text-red-500"></span>
            </div>

            <div>
                <label asp-for="Email" class="block text-sm font-medium text-neutral-700">อีเมล</label>
                <div class="mt-1">
                    <input asp-for="Email"
                           class="w-full px-3 py-2 border border-neutral-300 rounded-lg text-neutral-900 placeholder-neutral-400 focus:outline-none focus:ring-2 focus:ring-black focus:border-black sm:text-sm"
                           placeholder="staff@example.com" />
                </div>
                <span asp-validation-for="Email" class="mt-1 block text-xs text-red-500"></span>
            </div>

            <div>
                <label asp-for="Password" class="block text-sm font-medium text-neutral-700">รหัสผ่าน</label>
                <div class="mt-1">
                    <input asp-for="Password"
                           class="w-full px-3 py-2 border border-neutral-300 rounded-lg text-neutral-900 placeholder-neutral-400 focus:outline-none focus:ring-2 focus:ring-black focus:border-black sm:text-sm"
                           placeholder="อย่างน้อย 6 ตัวอักษร" />
                </div>
                <span asp-validation-for="Password" class="mt-1 block text-xs text-red-500"></span>
            </div>

            <div>
                <label asp-for="ConfirmPassword" class="block text-sm font-medium text-neutral-700">ยืนยันรหัสผ่าน</label>
                <div class="mt-1">
                    <input asp-for="ConfirmPassword"
                           class="w-full px-3 py-2 border border-neutral-300 rounded-lg text-neutral-900 placeholder-neutral-400 focus:outline-none focus:ring-2 focus:ring-black focus:border-black sm:text-sm"
                           placeholder="••••••••" />
                </div>
                <span asp-validation-for="ConfirmPassword" class="mt-1 block text-xs text-red-500"></span>
            </div>

            <div>
                <button type="submit"
                        class="w-full flex justify-center py-2.5 px-4 border border-transparent rounded-lg shadow-sm text-sm font-medium text-white bg-black hover:bg-neutral-800 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-black transition">
                    ยืนยันการสมัคร
                </button>
            </div>

            <div class="text-center">
                <span class="text-sm text-neutral-600">มีบัญชีอยู่แล้ว? </span>
                <a asp-action="Login" class="text-sm font-medium text-black hover:underline">
                    เข้าสู่ระบบที่นี่
                </a>
            </div>
        </form>
    </div>
</div>