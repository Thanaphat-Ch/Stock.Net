<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Stock Manager</title>
    <!-- Tailwind CSS Play CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-50 text-slate-800 min-h-screen">
    <nav class="bg-indigo-600 text-white shadow-sm">
        <div class="max-w-6xl mx-auto px-4 py-3 flex items-center justify-between">
            <span class="font-bold text-lg tracking-wide">📦 ระบบจัดการคลังสินค้า</span>
            @* <div class="text-xs bg-indigo-700 py-1 px-3 rounded-full"></div> *@
        </div>
    </nav>

    <main class="max-w-6xl mx-auto px-4 py-8">
        @RenderBody()
    </main>
</body>
</html>